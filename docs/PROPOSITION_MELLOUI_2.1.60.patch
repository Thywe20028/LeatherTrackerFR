+local function LayersWithLeatherTracker(spec)
+	if not leatherProvider then return spec end
+	local groups, switches = {}, {}
+	for i, group in ipairs(spec.groups) do
+		groups[#groups + 1] = group
+		if i == 1 then groups[#groups + 1] = "LeatherTracker FR" end
+	end
+	for _, row in ipairs(spec.switches) do
+		local copy = {}
+		for key, value in pairs(row) do copy[key] = value end
+		if copy.group > 1 then copy.group = copy.group + 1 end
+		switches[#switches + 1] = copy
+	end
+	local icons = {[0] = "track_todo", merchants = "svc_inn", creatures = "quest_mark", other = "pin_dungeon"}
+	for _, row in ipairs(leatherProvider.rows) do
+		switches[#switches + 1] = { key = "leathertracker:" .. row.id, label = row.name,
+			icon = icons[row.id], group = 2, leather = row.id }
+	end
+	local function find(key)
+		return leatherProvider.byKey[key]
+	end
+	return { groups = groups, switches = switches,
+		on = function(key)
+			local row = find(key)
+			if row then return row.checked end
+			return spec.on(key)
+		end,
+		set = function(key, on)
+			local row = find(key)
+			if row then return leatherProvider.set(row.id, on) end
+			return spec.set(key, on)
+		end }
+end
+
 function Log.Layers(spec)
-	S.layers = spec
+	nativeLayers = spec
+	S.layers = LayersWithLeatherTracker(spec)
 	if S.built and S.mode == "layers" then
-		LayersPage()   -- (the column left on the layers: its page now)
+		LayersPage()
 		Log.LayersChanged()
 	end
+end
+
+function MelloUI.Map:LeatherTrackerSetLayers(rows, setter)
+	if S.layerRows and not leatherHeading then return false end
+	local byKey = {}
+	for _, row in ipairs(rows) do byKey["leathertracker:" .. row.id] = row end
+	leatherProvider = {rows = rows, byKey = byKey, set = setter}
+	if nativeLayers then Log.Layers(nativeLayers) end
+	return true
+end
+
+function MelloUI.Map:LeatherTrackerLayerStatus()
+	return { created = leatherHeading ~= nil, rows = #leatherRows,
+		visible = leatherHeading ~= nil and leatherHeading:IsVisible() }
 end
 
